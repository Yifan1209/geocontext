.env
__pycache__/
*.pyc
data/cache/
data/streetview/
*.partial.pkl
trash/

# Generated viewers reference images under data/streetview/, which is not
# shipped, so a committed copy shows nothing but broken thumbnails. Regenerate
# them locally with the scripts in tools/.
results/*.html

# LaTeX build products. main.pdf is kept deliberately, so the paper can be read
# without a TeX installation; everything else here is regenerated by
#   pdflatex main && bibtex main && pdflatex main && pdflatex main
paper/*.aux
paper/*.log
paper/*.out
paper/*.blg
paper/*.toc
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk

# The arXiv upload is assembled from paper/ by copying main.tex, main.bbl and
# the four figures into a clean directory; it is an output, not a source.
paper/arxiv_submission/
paper/arxiv_submission.tar.gz
