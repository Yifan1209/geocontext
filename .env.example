# Copy to .env and fill in. .env is gitignored.
# Values may be quoted or bare. Use straight quotes " not curly “ ” —
# curly quotes become part of the key and cause a confusing UnicodeEncodeError.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Free token: https://www.mapillary.com/dashboard/developer
MAPILLARY_TOKEN=
